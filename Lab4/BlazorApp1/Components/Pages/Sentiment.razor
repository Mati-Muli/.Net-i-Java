@page "/sentiment"
@rendermode InteractiveServer
@using Microsoft.Extensions.ML
@inject PredictionEnginePool<MLModel.ModelInput, MLModel.ModelOutput> PredictionPool

<h1 class="text-center mb-4">Analiza Nastroju</h1>

<div class="mb-3">
    <textarea class="form-control" @bind="userInput" placeholder="Co cię trapi.."></textarea>
</div>

<button class="btn btn-primary" @onclick="Analyze">Analizuj</button>

@if (prediction != null)
{
    var isPositive = prediction.PredictedLabel.ToLower() == "positive";

    <div class="mt-3 alert @(isPositive ? "alert-success" : "alert-danger")">
        <p>Wynik: <strong>@prediction.PredictedLabel</strong></p>
        <p>Pewność: @(Math.Round(prediction.Score.Max() * 100, 2))%</p>
    </div>
}

@code {
    private string userInput = "";
    private MLModel.ModelOutput? prediction;

    private void Analyze()
    {
        if (!string.IsNullOrWhiteSpace(userInput))
        {
            prediction = PredictionPool.Predict(new MLModel.ModelInput { Text = userInput });
        }
    }
}